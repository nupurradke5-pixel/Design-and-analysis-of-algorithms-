#include <stdio.h>
#include <stdlib.h>


int max(int a, int b) {
    return (a > b) ? a : b;
}


int knapsack(int n, int values[], int weights[], int W) {
 
    int dp[n + 1][W + 1];


    for (int i = 0; i <= n; i++) {
        for (int w = 0; w <= W; w++) {

            if (i == 0 || w == 0) {
                dp[i][w] = 0;
            }

            else if (weights[i - 1] <= w) {
                dp[i][w] = max(values[i - 1] + dp[i - 1][w - weights[i - 1]], dp[i - 1][w]);
            }

            else {
                dp[i][w] = dp[i - 1][w];
            }
        }
    }

 
    return dp[n][W];
}

int main() {
    int n, W;


    if (scanf("%d", &n) != 1) return 0;

    int values[n];

    for (int i = 0; i < n; i++) {
        if (scanf("%d", &values[i]) != 1) return 0;
    }

    int weights[n];
 
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &weights[i]) != 1) return 0;
    }


    if (scanf("%d", &W) != 1) return 0;


    int result = knapsack(n, values, weights, W);
    printf("%d\n", result);

    return 0;
}

